mkcd() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: mkcd <directory>"
        return 1
    fi

    mkdir -p "$1" && cd "$1"
}

extract() {
    if [[ -z "${1:-}" ]]; then
        echo "Usage: extract <archive>"
        return 1
    fi

    if [[ ! -f "$1" ]]; then
        echo "File not found: $1"
        return 1
    fi

    case "$1" in
        *.tar.bz2|*.tbz2)
            tar xjf "$1"
            ;;
        *.tar.gz|*.tgz)
            tar xzf "$1"
            ;;
        *.bz2)
            bunzip2 "$1"
            ;;
        *.rar)
            if ! command -v unrar >/dev/null 2>&1; then
                echo "Error: 'unrar' is not installed."
                return 1
            fi
            unrar x "$1"
            ;;
        *.gz)
            gunzip "$1"
            ;;
        *.tar)
            tar xf "$1"
            ;;
        *.zip)
            unzip "$1"
            ;;
        *.7z)
            if ! command -v 7z >/dev/null 2>&1; then
                echo "Error: '7z' is not installed."
                return 1
            fi
            7z x "$1"
            ;;
        *)
            echo "Cannot extract: unsupported archive format."
            return 1
            ;;
    esac
}

worktree() {
    tree -L 2 "$HOME/Workspace"
}
